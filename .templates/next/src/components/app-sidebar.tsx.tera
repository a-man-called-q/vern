"use client";

{% if include_demos -%}
import {
	IconCamera,
	IconChartBar,
	IconDashboard,
	IconDatabase,
	IconFileAi,
	IconFileDescription,
	IconFileWord,
	IconFolder,
	IconHelp,
	IconInnerShadowTop,
	IconListDetails,
	IconReport,
	IconSearch,
	IconSettings,
	IconUsers,
} from "@tabler/icons-react";
{%- else -%}
import { IconDashboard, IconInnerShadowTop } from "@tabler/icons-react";
{%- endif %}
import {
	Sidebar,
	SidebarContent,
	SidebarFooter,
	SidebarHeader,
	SidebarMenu,
	SidebarMenuButton,
	SidebarMenuItem,
} from "@vern/ui/components/sidebar";
{%- if not include_demos %}
import Link from "next/link";
{%- endif %}
import type * as React from "react";
{%- if include_demos %}
import { NavDocuments } from "@/components/nav-documents";
{%- endif %}
import { NavMain } from "@/components/nav-main";
{%- if include_demos %}
import { NavSecondary } from "@/components/nav-secondary";
{%- endif %}
import { NavUser } from "@/components/nav-user";
{% if include_demos %}
const data = {
	navMain: [
		{
			title: "Dashboard",
			url: "#",
			icon: IconDashboard,
		},
		{
			title: "Lifecycle",
			url: "#",
			icon: IconListDetails,
		},
		{
			title: "Analytics",
			url: "#",
			icon: IconChartBar,
		},
		{
			title: "Projects",
			url: "#",
			icon: IconFolder,
		},
		{
			title: "Team",
			url: "#",
			icon: IconUsers,
		},
	],
	navClouds: [
		{
			title: "Capture",
			icon: IconCamera,
			isActive: true,
			url: "#",
			items: [
				{
					title: "Active Proposals",
					url: "#",
				},
				{
					title: "Archived",
					url: "#",
				},
			],
		},
		{
			title: "Proposal",
			icon: IconFileDescription,
			url: "#",
			items: [
				{
					title: "Active Proposals",
					url: "#",
				},
				{
					title: "Archived",
					url: "#",
				},
			],
		},
		{
			title: "Prompts",
			icon: IconFileAi,
			url: "#",
			items: [
				{
					title: "Active Proposals",
					url: "#",
				},
				{
					title: "Archived",
					url: "#",
				},
			],
		},
	],
	navSecondary: [
		{
			title: "Settings",
			url: "#",
			icon: IconSettings,
		},
		{
			title: "Get Help",
			url: "#",
			icon: IconHelp,
		},
		{
			title: "Search",
			url: "#",
			icon: IconSearch,
		},
	],
	documents: [
		{
			name: "Data Library",
			url: "#",
			icon: IconDatabase,
		},
		{
			name: "Reports",
			url: "#",
			icon: IconReport,
		},
		{
			name: "Word Assistant",
			url: "#",
			icon: IconFileWord,
		},
	],
};
{%- else %}
// Icons are components, which a Server Component cannot pass down as props, so
// the navigation lives in this client component. To add a page, create it under
// src/app/dashboard and add an item here.
const navItems = [
	{ title: "Dashboard", url: "/dashboard", icon: IconDashboard },
];
{%- endif %}

type AppSidebarProps = React.ComponentProps<typeof Sidebar> & {
	brandName: string;
	user: {
		name: string;
		email: string;
		subject: string;
	};
	apiStatus: "connected" | "not-configured" | "unavailable";
};

export function AppSidebar({
	brandName,
	user,
	apiStatus,
	...props
}: AppSidebarProps) {
	const apiStatusLabel = {
		connected: "Connected",
		"not-configured": "Not configured",
		unavailable: "Unavailable",
	}[apiStatus];
	const apiStatusColor = {
		connected: "bg-emerald-500",
		"not-configured": "bg-amber-500",
		unavailable: "bg-rose-500",
	}[apiStatus];

	return (
		<Sidebar collapsible="offcanvas" {...props}>
			<SidebarHeader>
				<SidebarMenu>
					<SidebarMenuItem>
						<SidebarMenuButton
							asChild
							className="data-[slot=sidebar-menu-button]:p-1.5!"
						>
{%- if include_demos %}
							<a href="#dashboard">
								<IconInnerShadowTop className="size-5!" />
								<span className="text-base font-semibold">{brandName}</span>
							</a>
{%- else %}
							<Link href="/dashboard">
								<IconInnerShadowTop className="size-5!" />
								<span className="text-base font-semibold">{brandName}</span>
							</Link>
{%- endif %}
						</SidebarMenuButton>
					</SidebarMenuItem>
				</SidebarMenu>
			</SidebarHeader>
			<SidebarContent>
{%- if include_demos %}
				<NavMain items={data.navMain} />
				<NavDocuments items={data.documents} />
				<NavSecondary items={data.navSecondary} className="mt-auto" />
{%- else %}
				<NavMain items={navItems} />
{%- endif %}
			</SidebarContent>
			<SidebarFooter>
				<div className="mx-2 rounded-lg border border-sidebar-border bg-sidebar-accent/40 px-3 py-2.5">
					<div className="flex items-center gap-2 text-xs font-medium">
						<span
							aria-hidden="true"
							className={`size-1.5 rounded-full ${apiStatusColor}`}
						/>
						API connection
						<span className="ml-auto text-sidebar-foreground/60">
							{apiStatusLabel}
						</span>
					</div>
				</div>
				<NavUser user={user} />
			</SidebarFooter>
		</Sidebar>
	);
}
