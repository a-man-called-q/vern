import { DashboardShell } from "@vern/app-shell/next/dashboard-shell";
import { ApiStatus } from "@/components/api-status";
import { navGroups } from "@/components/dashboard-nav";
{%- if include_demos %}
import { DemoSidebar } from "@/components/demo-sidebar";
{%- endif %}
import { SITE_NAME } from "@/lib/site";
import { getDashboardData } from "@/server/dashboard.server";

// The sidebar and header wrap every page under /dashboard. A layout does not
// render again when you move between those pages, so each page that needs a
// user still calls requireUser().
export default async function DashboardLayout({
	children,
}: LayoutProps<"/dashboard">) {
	const { user, apiStatus } = await getDashboardData();

	return (
		<DashboardShell
			siteName={SITE_NAME}
			user={user}
			navGroups={navGroups}
{%- if include_demos %}
			sidebarContent={<DemoSidebar />}
{%- endif %}
			sidebarFooter={<ApiStatus status={apiStatus} />}
		>
			{children}
		</DashboardShell>
	);
}
