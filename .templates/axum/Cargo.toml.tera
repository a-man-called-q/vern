[package]
name = "{{ name | kebab_case }}"
version = "0.1.0"
edition = "2024"

[dependencies]
{% if events %}async-nats = { version = "0.50", default-features = false, features = ["jetstream", "aws-lc-rs", "server_2_10"] }
{% endif %}async-trait = "0.1"
axum = "0.8"
{% if database %}chrono = { version = "0.4", default-features = false, features = ["clock", "serde"] }
{% endif %}dotenvy = "0.15"
{% if events %}futures-util = "0.3"
{% endif %}jsonwebtoken = { version = "11", default-features = false, features = ["use_pem", "rust_crypto"] }
moka = { version = "0.12", default-features = false, features = ["future"] }
reqwest = { version = "0.13", default-features = false, features = ["json", "form", "rustls"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sha2 = "0.10"
{% if database %}sqlx = { version = "0.8", default-features = false, features = ["runtime-tokio", "postgres", "migrate", "macros", "chrono", "uuid", "json"] }
{% endif %}thiserror = "2"
tokio = { version = "1", features = ["macros", "net", "rt-multi-thread", "time"] }
tower-http = { version = "0.7", features = ["trace"] }
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter", "fmt"] }
{% if database %}uuid = { version = "1", features = ["v7", "serde"] }
{% endif %}
[dev-dependencies]
tower = { version = "0.5", features = ["util"] }
