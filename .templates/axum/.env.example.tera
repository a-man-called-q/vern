PORT={{ port }}
ZITADEL_ISSUER=http://localhost:8081
ZITADEL_PROJECT_ID=replace-with-your-zitadel-project-id
ZITADEL_API_KEY_FILE=./secrets/zitadel-api-key.json
{% if database %}# Local PostgreSQL from the data project (moon run data:up). Replace the
# passwords before running anywhere else.
DATABASE_URL=postgres://{{ name | snake_case }}:{{ name | snake_case }}@localhost:5433/{{ name | snake_case }}
{% endif %}