{
  "name": "{{ name | kebab_case }}",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run generate-routes && vite dev",
    "generate-routes": "tsr generate",
    "build": "bun run generate-routes && vite build",
    "start": "bun scripts/serve.ts",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "bun run generate-routes && tsc --noEmit && biome check",
    "test": "bun test"
  },
  "dependencies": {
{% if include_demos %}    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faker-js/faker": "^10.3.0",
    "@tanstack/match-sorter-utils": "^9.1.2",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-table": "^9.2.4",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5",
{% endif %}    "@tabler/icons-react": "^3.48.0",
    "@vern/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.60",
    "openid-client": "^6.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^6.3.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
