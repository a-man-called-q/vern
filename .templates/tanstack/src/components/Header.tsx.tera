import { Link } from "@tanstack/react-router";
{%- if include_demos %}
import { Button } from "@vern/ui/components/button";
import {
	DropdownMenu,
	DropdownMenuContent,
	DropdownMenuItem,
	DropdownMenuTrigger,
} from "@vern/ui/components/dropdown-menu";
{%- endif %}
import { SITE_NAME } from "../lib/site";
import AuthControls from "./AuthControls";
import ThemeToggle from "./ThemeToggle";

export default function Header() {
	return (
		<header className="sticky top-0 z-50 border-b bg-background/95 px-4 backdrop-blur supports-[backdrop-filter]:bg-background/80">
			<nav className="page-wrap flex min-h-16 items-center gap-3">
				<Link
					className="rounded-md px-2 py-1 text-base font-bold tracking-tight text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
					to="/"
				>
					{SITE_NAME}
				</Link>
{%- if include_demos %}
				<div className="flex items-center gap-1">
					<Button variant="ghost" size="sm" asChild>
						<Link to="/" activeProps={% raw %}{{ className: "text-foreground" }}{% endraw %}>
							Home
						</Link>
					</Button>
					<Button variant="ghost" size="sm" asChild>
						<Link to="/about" activeProps={% raw %}{{ className: "text-foreground" }}{% endraw %}>
							About
						</Link>
					</Button>
					<DropdownMenu>
						<DropdownMenuTrigger asChild>
							<Button variant="ghost" size="sm">
								Demos
							</Button>
						</DropdownMenuTrigger>
						<DropdownMenuContent align="start">
							<DropdownMenuItem asChild>
								<Link to="/demo/form/simple">Simple Form</Link>
							</DropdownMenuItem>
							<DropdownMenuItem asChild>
								<Link to="/demo/form/address">Address Form</Link>
							</DropdownMenuItem>
							<DropdownMenuItem asChild>
								<Link to="/demo/table">TanStack Table</Link>
							</DropdownMenuItem>
							<DropdownMenuItem asChild>
								<Link to="/demo/tanstack-query">TanStack Query</Link>
							</DropdownMenuItem>
						</DropdownMenuContent>
					</DropdownMenu>
				</div>
{%- endif %}
				<div className="ml-auto flex items-center gap-1">
					<AuthControls />
					<ThemeToggle />
				</div>
			</nav>
		</header>
	);
}
