apiVersion: v1
kind: Service
metadata:
  name: {{ name | kebab_case }}
  labels:
    app.kubernetes.io/name: {{ name | kebab_case }}
    app.kubernetes.io/component: web
spec:
  selector:
    app.kubernetes.io/name: {{ name | kebab_case }}
  ports:
    - name: http
      port: 80
      targetPort: http
