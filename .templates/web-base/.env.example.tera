PORT={{ port }}
APP_URL=http://localhost:{{ port }}
ZITADEL_CLIENT_ID=replace-with-your-zitadel-client-id
SESSION_SECRET=
# The Axum app under services/ this app calls. `bun run setup` turns it into
# API_BASE_URL; it is only needed when the workspace has more than one API.
API_APP=
API_BASE_URL=
# More Axum apps this app calls, separated by commas. `bun run setup` gives each
# a variable with its URL (inventory becomes INVENTORY_API_URL), which a server
# module reads with `createApiClient("INVENTORY_API_URL")`.
API_APPS=
