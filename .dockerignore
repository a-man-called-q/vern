# Build context for the web app images (apps/*/Dockerfile), which build from the
# repository root. Dependencies and build output are recreated in the image;
# environment files and secrets never enter it.
.git
.moon/cache
**/node_modules
**/.next
**/dist
**/dist-ssr
**/.tanstack
**/.output
**/target
**/storybook-static
**/*.tsbuildinfo
**/secrets
**/.env
**/.env.*
!**/.env.example
deploy
# The Axum APIs and their Cargo workspace: an API image has its own list, in
# services/<name>/Dockerfile.dockerignore.
services
crates
Cargo.toml
Cargo.lock
