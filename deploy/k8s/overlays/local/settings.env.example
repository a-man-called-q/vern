# Settings for deploy/k8s/overlays/local, which `bun run setup -- --kubernetes
# local` reads. It copies this file to settings.env on its first run.

# ZITADEL is on auth.<DOMAIN>, and each web app and API on <name>.<DOMAIN>.
# localtest.me and its subdomains resolve to 127.0.0.1, where
# deploy/k8s/local-cluster.sh has the cluster's ingress listen.
DOMAIN=localtest.me
# The IngressClass of the cluster's ingress controller (local-cluster.sh
# installs Traefik).
INGRESS_CLASS=traefik

ZITADEL_ORG_NAME=Vern
ZITADEL_ADMIN_USERNAME=zitadel-admin
# Whether anyone can create an account from the sign-in page.
ZITADEL_ALLOW_REGISTER=false
