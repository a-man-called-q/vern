# Settings for deploy/docker-compose.yml. Copy this file to deploy/.env on the
# server and set the first block; `bun run setup -- --deploy` generates the
# secrets and fills in what it creates in ZITADEL.

# Public hostnames. Point their DNS records at the server before the first start:
# Let's Encrypt checks them.
AUTH_DOMAIN=auth.example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# Folders under apps/ to deploy: one web app and one Axum API.
WEB_APP=dashboard
API_APP=api

# Same pair as apps/auth-server/.env.example; change them together.
ZITADEL_VERSION=v4.19.3
ZITADEL_LOGIN_IMAGE=ghcr.io/a-man-called-q/vern-zitadel-login:v4.19.3-bb46521c3b02a3319c4487eb6236b58492db403c

ZITADEL_ORG_NAME=Vern
ZITADEL_ADMIN_USERNAME=zitadel-admin

# Whether anyone can create an account from the sign-in page ("Sign up"). Keep
# `false` when an administrator creates the accounts; `true` lets any visitor
# register, with no roles. `bun run setup -- --deploy` applies a changed value
# to a running instance.
ZITADEL_ALLOW_REGISTER=false

# Generated by `bun run setup -- --deploy` when empty. Keep a copy in your
# secret manager: ZITADEL_MASTERKEY encrypts data in the database, and losing it
# loses that data.
ZITADEL_MASTERKEY=
ZITADEL_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
WEB_SESSION_SECRET=

# Written by `bun run setup -- --deploy`.
ZITADEL_PROJECT_ID=
WEB_CLIENT_ID=
