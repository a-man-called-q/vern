# Settings for deploy/prod, which `bun run setup --
# --kubernetes prod` reads. Copy it to settings.env and set the first
# block. settings.env stays out of Git: it can hold SMTP_PASSWORD.

# ZITADEL is on auth.<DOMAIN> (or AUTH_HOST), and each web app and API on
# <name>.<DOMAIN>. Point their DNS records at the cluster's ingress.
DOMAIN=example.com
AUTH_HOST=
# Where the images are: <IMAGE_REGISTRY>/<app>:<IMAGE_TAG>.
# .github/workflows/images.yml pushes every app there, tagged with the commit.
IMAGE_REGISTRY=ghcr.io/your-org/your-repo
# Empty takes the commit setup runs on (git rev-parse HEAD).
IMAGE_TAG=
# The IngressClass of the cluster's ingress controller, and the cert-manager
# ClusterIssuer that signs the hostnames' certificates.
INGRESS_CLASS=traefik
CLUSTER_ISSUER=letsencrypt

ZITADEL_ORG_NAME=Vern
ZITADEL_ADMIN_USERNAME=zitadel-admin
# Whether anyone can create an account from the sign-in page. `bun run setup
# -- --kubernetes prod` applies a changed value to a running instance.
ZITADEL_ALLOW_REGISTER=false

# The mail server ZITADEL sends through, as in deploy/compose/.env.example. Without
# SMTP_HOST no invitation, email verification, or password reset is sent.
SMTP_HOST=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
SMTP_USER=
SMTP_PASSWORD=
SMTP_REPLY_TO=
SMTP_TLS=true
