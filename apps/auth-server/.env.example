# Local-only defaults. Copy this file to .env before starting the stack.
# Replace every secret before exposing the service outside localhost.

# The backend and the Login App must run the same ZITADEL release; change both
# lines together. The Login image adds the Vern sign-in shell to the ZITADEL
# Login App: https://github.com/a-man-called-q/vern-zitadel-login
# The stock ghcr.io/zitadel/zitadel-login:<ZITADEL_VERSION> image also works,
# without the shell and the brand/ folder.
ZITADEL_VERSION=v4.19.3
ZITADEL_LOGIN_IMAGE=ghcr.io/a-man-called-q/vern-zitadel-login:v4.19.3-bb46521c3b02a3319c4487eb6236b58492db403c
ZITADEL_DOMAIN=localhost
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z

POSTGRES_DB=zitadel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

ZITADEL_ORG_NAME=Vern
ZITADEL_ADMIN_USERNAME=zitadel-admin
ZITADEL_ADMIN_PASSWORD=Password1!

# Password of the users in ../../seed-users.json. Only a local `bun run setup`
# creates them; it generates this password when the line is empty.
ZITADEL_SEED_PASSWORD=
