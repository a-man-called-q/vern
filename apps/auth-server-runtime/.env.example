# Local-only defaults. Copy this file to .env before starting the stack.
# Replace every secret before exposing the service outside localhost.

ZITADEL_VERSION=v4.17.1
# Keep the Login image on the same upstream release as ZITADEL_VERSION.
# The official image is used when this override is unset. Once available, switch
# to the public Vern fork image for the same upstream version, for example:
# ZITADEL_LOGIN_IMAGE=ghcr.io/a-man-called-q/vern-zitadel-login:v4.17.1-vern.<commit-sha>
ZITADEL_DOMAIN=localhost
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z

POSTGRES_DB=zitadel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

ZITADEL_ORG_NAME=Vern
ZITADEL_ADMIN_USERNAME=zitadel-admin
ZITADEL_ADMIN_PASSWORD=Password1!
