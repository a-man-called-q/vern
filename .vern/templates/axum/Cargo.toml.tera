[package]
name = "{{ name | kebab_case }}"
version.workspace = true
edition.workspace = true
publish.workspace = true

# The versions are in the Cargo.toml at the repository root, one for every API.
# For a new dependency, add it there and name it here.
[dependencies]
{% if not worker %}axum = { workspace = true }
{% endif %}{% if database %}chrono = { workspace = true }
{% endif %}serde = { workspace = true }
{% if database %}sqlx = { workspace = true }
{% endif %}{% if not worker %}svc-auth = { workspace = true }
{% endif %}svc-boot = { workspace = true }
{% if database %}svc-db = { workspace = true }
{% endif %}{% if events %}svc-events = { workspace = true }
{% endif %}svc-http = { workspace = true }
thiserror = { workspace = true }
tokio = { workspace = true }

[dev-dependencies]
{% if not worker %}serde_json = { workspace = true }
{% endif %}{% if not worker %}svc-auth = { workspace = true, features = ["testing"] }
{% endif %}{% if not worker %}tower = { workspace = true }
{% endif %}
[lints]
workspace = true
