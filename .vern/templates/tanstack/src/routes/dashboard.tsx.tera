import { createFileRoute, Outlet } from "@tanstack/react-router";
import { DashboardShell } from "@vern/app-shell/tanstack/dashboard-shell";
import { ApiStatus } from "../components/api-status";
import { navGroups } from "../components/dashboard-nav";
{%- if include_demos %}
import { DemoSidebar } from "../components/demo-sidebar";
{%- endif %}
import { SITE_NAME } from "../lib/site";
import { getDashboardDataFn } from "../server/auth";

// The sidebar and header wrap every route under /dashboard.
export const Route = createFileRoute("/dashboard")({
	loader: () => getDashboardDataFn(),
	component: DashboardLayout,
});

function DashboardLayout() {
	const { user, apiStatus } = Route.useLoaderData();

	return (
		<DashboardShell
			siteName={SITE_NAME}
			user={user}
			navGroups={navGroups}
{%- if include_demos %}
			sidebarContent={<DemoSidebar />}
{%- endif %}
			sidebarFooter={<ApiStatus status={apiStatus} />}
		>
			<Outlet />
		</DashboardShell>
	);
}
