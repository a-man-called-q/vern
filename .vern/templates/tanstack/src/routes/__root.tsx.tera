import { TanStackDevtools } from "@tanstack/react-devtools";
{%- if include_demos %}
import type { QueryClient } from "@tanstack/react-query";
{%- endif %}
import {
{%- if include_demos %}
	createRootRouteWithContext,
{%- else %}
	createRootRoute,
{%- endif %}
	HeadContent,
	Scripts,
	useRouterState,
} from "@tanstack/react-router";
import { TanStackRouterDevtoolsPanel } from "@tanstack/react-router-devtools";
import { SiteLayout } from "@vern/app-shell/tanstack/site-layout";
{%- if include_demos %}
import { SiteNav } from "../components/site-nav";
import TanStackQueryDevtools from "../integrations/tanstack-query/devtools";
{%- endif %}
import { SITE_NAME } from "../lib/site";
import { getCurrentUserFn } from "../server/auth";
import appCss from "../styles.css?url";
{%- if include_demos %}

interface MyRouterContext {
	queryClient: QueryClient;
}

export const Route = createRootRouteWithContext<MyRouterContext>()({
{%- else %}

export const Route = createRootRoute({
{%- endif %}
	head: () => ({
		meta: [
			{
				charSet: "utf-8",
			},
			{
				name: "viewport",
				content: "width=device-width, initial-scale=1",
			},
			{
				title: SITE_NAME,
			},
		],
		links: [
			{
				rel: "stylesheet",
				href: appCss,
			},
		],
	}),
	shellComponent: RootDocument,
});

function RootDocument({ children }: { children: React.ReactNode }) {
	const pathname = useRouterState({
		select: (state) => state.location.pathname,
	});
	const isDashboard =
		pathname === "/dashboard" || pathname.startsWith("/dashboard/");

	return (
		<html lang="en" suppressHydrationWarning>
			<head>
				<script src="/theme-init.js" />
				<HeadContent />
			</head>
			<body className="font-sans antialiased [overflow-wrap:anywhere] selection:bg-primary/20">
				{isDashboard ? (
					children
{%- if include_demos %}
				) : (
					<SiteLayout
						siteName={SITE_NAME}
						getUser={getCurrentUserFn}
						nav={<SiteNav />}
						footerNote={
							<p className="m-0 text-xs">
								A full stack starter for modern applications.
							</p>
						}
					>
						{children}
					</SiteLayout>
				)}
{%- else %}
				) : (
					<SiteLayout siteName={SITE_NAME} getUser={getCurrentUserFn}>
						{children}
					</SiteLayout>
				)}
{%- endif %}
				<TanStackDevtools
					config={% raw %}{{
						position: "bottom-right",
					}}{% endraw %}
					plugins={[
						{
							name: "Tanstack Router",
							render: <TanStackRouterDevtoolsPanel />,
						},
{%- if include_demos %}
						TanStackQueryDevtools,
{%- endif %}
					]}
				/>
				<Scripts />
			</body>
		</html>
	);
}
